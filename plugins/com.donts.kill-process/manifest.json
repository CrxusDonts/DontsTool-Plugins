{
  "schemaVersion": 1,
  "id": "com.donts.kill-process",
  "name": "结束进程",
  "version": "1.0.0",
  "description": "kill / kp 按名称、PID 或 :端口 列出并结束运行中的进程",
  "minHostVersion": "0.2.14",
  "keywords": ["kill", "kp", "进程"],
  "supportsGlobalSearch": false,
  "globalAliases": ["kill", "kill process", "kp", "结束进程", "杀进程", "进程"],
  "phase": "fast",
