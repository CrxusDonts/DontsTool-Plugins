  "priority": 50,
  "homeEntry": {
    "canonicalKey": "process:entry",
    "title": "结束进程",
    "subtitle": "输入 kill 进程名、PID 或 :端口号，列出并结束运行中的进程",
    "symbol": "xmark.octagon",
    "tint": "red",
    "score": 899
  },
  "runtime": {
    "mode": "daemon",
    "command": ["bin/KillProcessPlugin"],
    "timeoutMs": 2000,
    "idleTimeoutSec": 300
  },
  "permissions": [
    "clipboard.write",
    "revealInFinder",
    "prefill",
    "toast",
    "refresh"
  ]
}
